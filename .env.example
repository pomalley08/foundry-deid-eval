# Copy to .env (gitignored) and fill in. Never commit secrets.

# --- Model targets (optional; needed only to run de-ID models live) -----------------------
# Azure OpenAI / Foundry resource that hosts the model deployments to compare.
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
# Comma-separated deployment names. Each deployment becomes one de-ID target.
AZURE_OPENAI_DEPLOYMENTS=gpt-4.1-mini,gpt-5.4-nano
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Optional. Leave unset to use keyless Microsoft Entra ID auth (az login / DefaultAzureCredential).
# AZURE_OPENAI_API_KEY=

# --- Foundry evaluation (optional; needed for cloud runs and the gate) --------------------
FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
# Any model deployment in the project. The code evaluators never call it, but the API requires
# one. Defaults to the first entry in AZURE_OPENAI_DEPLOYMENTS.
# FOUNDRY_EVAL_DEPLOYMENT=gpt-4.1-mini
# Name of the standing eval that accumulates runs. Use one per pipeline or project.
# FOUNDRY_EVAL_NAME=deid-quality-gate

# --- Your data ------------------------------------------------------------------------------
# Folder with your notes.jsonl and cache/ (target outputs). Defaults to data/ (the synthetic
# sample). Keep real data in a gitignored folder such as data/private.
# DEID_DATA_DIR=data/private
